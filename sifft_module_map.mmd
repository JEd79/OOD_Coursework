      DVC --> DVR
      DVS --> DVH
      DVV --> DVH
    end
    subgraph TW["table_writing package"]
      TWW["writer.py\nwrite_table"]
      TWV["validation.py\nvalidate_write_options"]
      TWM["mode_handlers.py\nmode dispatch"]
      TWF["format_handlers.py\nDelta / Parquet / ORC"]
